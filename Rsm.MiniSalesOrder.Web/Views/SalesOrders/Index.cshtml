@model IEnumerable<Rsm.MiniSalesOrder.Web.Models.SalesOrderViewModel>

@{
    ViewData["Title"] = "Órdenes de Venta";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Órdenes de Venta</h1>
        <p class="text-muted mb-0">Consulta y administra las órdenes registradas en el sistema.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">Crear Nueva Orden</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border">
        <h5 class="mb-2">No hay órdenes registradas</h5>
        <p class="mb-3">Todavía no se ha creado ninguna orden de venta.</p>
        <a asp-action="Create" class="btn btn-primary">Crear primera orden</a>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Número</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var badgeClass = item.Status switch
                            {
                                Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.New => "bg-secondary",
                                Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.Processing => "bg-primary",
                                Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.Shipped => "bg-info text-dark",
                                Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.Invoiced => "bg-success",
                                _ => "bg-dark"
                            };

                            <tr>
                                <td class="fw-semibold">@item.OrderNumber</td>
                                <td>@item.CustomerName</td>
                                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @badgeClass">@item.StatusName</span>
                                </td>
                                <td class="text-end fw-semibold">@item.Total.ToString("C2")</td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        Detalles
                                    </a>

                                    @if (item.Status == Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.New)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning ms-1">
                                            Editar
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}