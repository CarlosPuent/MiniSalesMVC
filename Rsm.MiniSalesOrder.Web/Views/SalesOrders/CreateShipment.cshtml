@model Rsm.MiniSalesOrder.Web.Models.ShipmentViewModel

@{
    ViewData["Title"] = "Registrar Envío";
}

<div class="mb-4">
    <h1 class="mb-1">Registrar Envío</h1>
    <p class="text-muted mb-0">Completa la información logística asociada a la orden.</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <form asp-action="CreateShipment" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="SalesOrderId" />

            <div class="mb-3">
                <label asp-for="ShippingAddress" class="form-label"></label>
                <textarea asp-for="ShippingAddress" class="form-control" rows="3"></textarea>
                <span asp-validation-for="ShippingAddress" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Carrier" class="form-label"></label>
                <input asp-for="Carrier" class="form-control" />
                <span asp-validation-for="Carrier" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TrackingNumber" class="form-label"></label>
                <input asp-for="TrackingNumber" class="form-control" />
                <span asp-validation-for="TrackingNumber" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">Registrar Envío</button>
                <a asp-action="Details" asp-route-id="@Model.SalesOrderId" class="btn btn-outline-secondary">Volver a la
                    Orden</a>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }