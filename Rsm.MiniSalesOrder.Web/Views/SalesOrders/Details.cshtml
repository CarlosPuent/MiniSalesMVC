@model Rsm.MiniSalesOrder.Web.Models.SalesOrderViewModel

@{
    ViewData["Title"] = "Detalles de Orden";

    var badgeClass = Model.Status switch
    {
        Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.New => "bg-secondary",
        Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.Processing => "bg-primary",
        Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.Shipped => "bg-info text-dark",
        Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.Invoiced => "bg-success",
        _ => "bg-dark"
    };

    var shipment = Model.Shipment;
    var invoice = Model.Invoice;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="mb-1">Detalles de Orden</h1>
        <p class="text-muted mb-0">Consulta la información general, artículos, envío y factura.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver a la Lista</a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Información de la Orden</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Número</dt>
                    <dd class="col-sm-8">@Model.OrderNumber</dd>

                    <dt class="col-sm-4">Cliente</dt>
                    <dd class="col-sm-8">@Model.CustomerName</dd>

                    <dt class="col-sm-4">Fecha</dt>
                    <dd class="col-sm-8">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        <span class="badge @badgeClass">@Model.StatusName</span>
                    </dd>

                    <dt class="col-sm-4">Notas</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.Notes) ? "Sin notas registradas." : Model.Notes)
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Totales</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Subtotal</dt>
                    <dd class="col-sm-8">@Model.Subtotal.ToString("C2")</dd>

                    <dt class="col-sm-4">Impuesto</dt>
                    <dd class="col-sm-8">@Model.Tax.ToString("C2")</dd>

                    <dt class="col-sm-4">Total</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Total.ToString("C2")</dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-light">
                <h5 class="mb-0">Acciones</h5>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.Status == Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.New)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">Editar</a>
                    }

                    @if (Model.CanAddItems)
                    {
                        <a asp-action="AddItem" asp-route-id="@Model.Id" class="btn btn-primary">Agregar Artículo</a>
                    }

                    @if (Model.CanProcessOrder)
                    {
                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="newStatus"
                                   value="@((int)Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.Processing)" />
                            <button type="submit" class="btn btn-success">Procesar Orden</button>
                        </form>
                    }

                    @if (Model.CanShipOrder)
                    {
                        <a asp-action="CreateShipment" asp-route-id="@Model.Id" class="btn btn-info text-dark">Registrar
                            Envío</a>
                        }

                        @if (Model.CanInvoiceOrder)
                        {
                            <a asp-action="CreateInvoice" asp-route-id="@Model.Id" class="btn btn-success">Generar Factura</a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            @if (shipment is not null)
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Información de Envío</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Dirección</dt>
                            <dd class="col-sm-8">@shipment.ShippingAddress</dd>

                            <dt class="col-sm-4">Fecha</dt>
                            <dd class="col-sm-8">@shipment.ShippingDate.ToString("dd/MM/yyyy HH:mm")</dd>

                            <dt class="col-sm-4">Transportista</dt>
                            <dd class="col-sm-8">@shipment.Carrier</dd>

                            <dt class="col-sm-4">Tracking</dt>
                            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(shipment.TrackingNumber) ? "No registrado" :
                                                        shipment.TrackingNumber)</dd>

                                <dt class="col-sm-4">Estado</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-info text-dark">@shipment.StatusName</span>
                                </dd>
                            </dl>
                        </div>
                    </div>
                }

                @if (invoice is not null)
                {
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">Información de Factura</h5>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Número</dt>
                                <dd class="col-sm-8">@invoice.InvoiceNumber</dd>

                                <dt class="col-sm-4">Fecha</dt>
                                <dd class="col-sm-8">@invoice.InvoiceDate.ToString("dd/MM/yyyy HH:mm")</dd>

                                <dt class="col-sm-4">Monto</dt>
                                <dd class="col-sm-8">@invoice.Amount.ToString("C2")</dd>

                                <dt class="col-sm-4">Pago</dt>
                                <dd class="col-sm-8">
                                    @if (invoice.Paid)
                                    {
                                        <span class="badge bg-success">Pagada</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente de pago</span>
                                    }
                                </dd>
                            </dl>

                            @if (!invoice.Paid)
                            {
                                <div class="mt-3">
                                    <form asp-action="UpdateInvoice" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="paid" value="true" />
                                        <button type="submit" class="btn btn-sm btn-success">Marcar como Pagada</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0 mt-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Artículos de la Orden</h5>
                <span class="badge bg-dark">@Model.Items.Count artículo(s)</span>
            </div>
            <div class="card-body">
                @if (Model.Items.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th class="text-end">Precio Unitario</th>
                                    <th class="text-end">Total</th>
                                    @if (Model.CanAddItems)
                                    {
                                        <th class="text-center">Acciones</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrWhiteSpace(item.ProductName) ? "Producto" : item.ProductName)</td>
                                        <td>@item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("C2")</td>
                                        <td class="text-end fw-semibold">@item.LineTotal.ToString("C2")</td>
                                        @if (Model.CanAddItems)
                                        {
                                            <td class="text-center">
                                                <form asp-action="RemoveItem" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="orderId" value="@Model.Id" />
                                                    <input type="hidden" name="itemId" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted">No hay artículos en esta orden.</div>
                }
            </div>
        </div>