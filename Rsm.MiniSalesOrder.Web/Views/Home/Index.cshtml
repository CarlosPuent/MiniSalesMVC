@model Rsm.MiniSalesOrder.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Mini Sales Order</h1>
    <p class="text-muted">Sistema de gestión de órdenes de venta</p>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary h-100 shadow-sm border-0">
            <div class="card-header">Clientes</div>
            <div class="card-body d-flex flex-column">
                <h3 class="card-title">@Model.TotalCustomers</h3>
                <p class="card-text flex-grow-1">Total de clientes registrados.</p>
                <a asp-controller="Customers" asp-action="Index" class="btn btn-light">Ver Clientes</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-success h-100 shadow-sm border-0">
            <div class="card-header">Productos</div>
            <div class="card-body d-flex flex-column">
                <h3 class="card-title">@Model.TotalProducts</h3>
                <p class="card-text flex-grow-1">Total de productos disponibles.</p>
                <a asp-controller="Products" asp-action="Index" class="btn btn-light">Ver Productos</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-info h-100 shadow-sm border-0">
            <div class="card-header">Órdenes</div>
            <div class="card-body d-flex flex-column">
                <h3 class="card-title">@Model.TotalOrders</h3>
                <p class="card-text flex-grow-1">Total de órdenes registradas.</p>
                <a asp-controller="SalesOrders" asp-action="Index" class="btn btn-light">Ver Órdenes</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-dark bg-warning h-100 shadow-sm border-0">
            <div class="card-header">Nueva Orden</div>
            <div class="card-body d-flex flex-column">
                <h3 class="card-title">+</h3>
                <p class="card-text flex-grow-1">Registra una nueva orden de venta.</p>
                <a asp-controller="SalesOrders" asp-action="Create" class="btn btn-light">Crear Orden</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-md-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light">
                <h5 class="mb-0">Órdenes por Estado</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3 text-center">
                        <div class="card bg-light h-100">
                            <div class="card-body">
                                <h3>@Model.OrdersByStatus[Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.New]</h3>
                                <p class="mb-2">Nuevas</p>
                                <span class="badge bg-secondary">Nuevas</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 text-center">
                        <div class="card bg-light h-100">
                            <div class="card-body">
                                <h3>@Model.OrdersByStatus[Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.Processing]
                                </h3>
                                <p class="mb-2">En Proceso</p>
                                <span class="badge bg-primary">En Proceso</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 text-center">
                        <div class="card bg-light h-100 border-warning">
                            <div class="card-body">
                                <h3>@Model.PendingInvoiceCount</h3>
                                <p class="mb-2">Pendientes de Factura</p>
                                <span class="badge bg-warning text-dark">Pendiente Factura</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 text-center">
                        <div class="card bg-light h-100">
                            <div class="card-body">
                                <h3>@Model.OrdersByStatus[Rsm.MiniSalesOrder.Domain.Enums.SalesOrderStatus.Invoiced]
                                </h3>
                                <p class="mb-2">Facturadas</p>
                                <span class="badge bg-success">Facturadas</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-3 text-muted small">
                    “Pendientes de Factura” representa las órdenes enviadas que aún no han sido facturadas.
                </div>
            </div>
        </div>
    </div>
</div>